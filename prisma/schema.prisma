// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  password      String?
  image         String?
  customAvatar  String?   @map("custom_avatar")
  dob           DateTime?
  country       String?
  gender        String?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  accounts      Account[]
  Like          Like[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Track {
  id             String    @id
  title          String
  coverSmall     String?   @map("cover_small")
  coverBig       String?   @map("cover_big")
  preview        String?
  artistSourceId Int?      @map("artist_source_id")
  artistName     String?   @map("artist_name")
  albumSourceId  Int?      @map("album_source_id")
  albumTitle     String?   @map("album_title")
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt
  Like           Like[]

  @@map("tracks")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Like {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id")
  trackId    String    @map("track_id")
  user       User      @relation(fields: [userId], references: [id])
  track      Track     @relation(fields: [trackId], references: [id])
  isDislike  Boolean?  @default(false) @map("is_dislike")
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([userId, trackId])
  @@map("likes")
}
